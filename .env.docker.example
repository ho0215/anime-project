# docker compose 용 예시 → 복사: cp .env.docker.example .env

DJANGO_SECRET_KEY=local-dev-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
USE_HTTPS=False

DB_NAME=aniverse
DB_USER=aniverse
DB_PASSWORD=aniversepass
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=rootpass

# 컨테이너 브리지가 막힌 환경에서만 (에이전트/일부 CI):
# COMPOSE_DB_HOST=host.docker.internal
# COMPOSE_DB_PORT=3307

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
