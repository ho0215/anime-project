# 로컬 개발용 예시. EC2 에서는 Terraform user_data 가 자동 생성한다.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# 프로덕션(ALB HTTPS): USE_HTTPS=True, DJANGO_ALLOWED_HOSTS=aniverse.my,www.aniverse.my
USE_HTTPS=False
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

DB_NAME=aniverse
DB_USER=admin
DB_PASSWORD=admin1234!
DB_HOST=127.0.0.1
DB_PORT=3306

# 비워 두면 EC2 IAM Role / 로컬 파일스토리지 사용
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2

# AI 챗봇 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
